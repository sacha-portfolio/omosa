<div
  id="Banner-{{ section.id }}"
  class="
    relative
    flex
    flex-col
    isolate
    pt-[{{ block.settings.padding_top }}px]!
    pb-[{{ block.settings.padding_bottom }}px]!
    pr-[{{ block.settings.padding_right }}px]!
    pl-[{{ block.settings.padding_left }}px]!
    after:content-['']
    after:absolute after:inset-0
    after:w-full
    after:h-full
    after:bg-[#000]
    after:opacity-0
    after:z-[1]
    min-[750px]:flex-row
    max-[749px]:flex-row
    max-[749px]:flex-wrap
    max-[749px]:before:hidden!
    {% if block.settings.flex_basis_style %} basis-[{{ block.settings.flex_basis }}%]{% endif %}
  "
>
  <div
    class="
      relative
      flex
      items-center
      justify-center
      z-[2]
    "
  >
    <div
      class="
        relative
        z-[1]
        text-center
        flex
        items-center
        h-fit
        break-words
        max-[749px]:border-none
        max-[749px]:rounded-none
        max-[749px]:shadow-none
        relative
        rounded-[var(--text-boxes-radius)]
        border-solid
        [border-width:var(--text-boxes-border-width)]
        [border-color:rgba(var(--color-foreground),var(--text-boxes-border-opacity))]
        after:content-['']
        after:absolute after:inset-0
        after:z-[-1]
        max-[749px]:border-l-0
        max-[749px]:border-r-0
        max-[749px]:rounded-none
        max-[749px]:after:hidden
      "
    >
      <div class="w-full my-0" {{ block.shopify_attributes }}>
        {% form 'customer',
          class: 'inline-block items-center w-full relative min-[750px]:items-start min-[750px]:mx-auto'
        %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div
            class="
              inline-block
              w-full
            "
          >
            <div
              class="
                relative
                z-0
                flex
                w-full
                transition-shadow
                duration-[var(--duration-short)]
                ease-[cubic-bezier(0.25,0.1,0.25,1)]
                before:pointer-events-none
                before:content-['']
                before:absolute before:inset-0
                before:rounded-[var(--inputs-radius-outset)]
                before:shadow-[var(--inputs-shadow-horizontal-offset)_var(--inputs-shadow-vertical-offset)_var(--inputs-shadow-blur-radius)_rgba(var(--color-shadow),var(--inputs-shadow-opacity))]
                before:z-[-1]
              "
            >
              <input
                id="NewsletterForm--{{ section.id }}"
                type="email"
                name="contact[email]"
                class="
                  relative
                  max-w-full
                  w-[{{ block.settings.width }}px]
                  box-border
                  border-{{  block.settings.border_style }}
                  border-[{{  block.settings.border_width }}px]
                  border-[{{ block.settings.border_color }}]
                  rounded-[{{ block.settings.border_radius }}px]
                  hover:shadow-[inset_0_0_0_1000px_rgba(0,0,0,0.03)]
                  duration-200
                  flex-grow
                  text-left
                  text-[1rem]
                  leading-[calc(1+.5/var(--font-body-scale))]
                  tracking-[0.025rem]
                  text-[{{ block.settings.color }}]
                  h-[2.8125rem]
                  min-h-[calc(var(--inputs-border-width)*2)]
                  py-[0.9375rem]
                  pr-[3.125rem]
                  pl-[1.25rem]
                  m-[var(--inputs-border-width)]
                  appearance-none
                  bg-[{{ block.settings.color_background }}]
                  transition-shadow
                  duration-[var(--duration-short)]
                  ease-[cubic-bezier(0.25,0.1,0.25,1)]
                  placeholder:opacity-0
                  [&::-webkit-search-cancel-button]:hidden
                  focus:pt-[1.375rem]
                  focus:pb-[0.5rem]
                  focus:pl-[1.25rem]
                  focus-visible:pt-[1.375rem]
                  focus-visible:pb-[0.5rem]
                  focus-visible:pl-[1.25rem]
                  autofill:pt-[1.375rem]
                  autofill:pb-[0.5rem]
                  autofill:pl-[1.25rem]
                  [&:not(:placeholder-shown)]:pt-[1.375rem]
                  [&:not(:placeholder-shown)]:pb-[0.5rem]
                  [&:not(:placeholder-shown)]:pl-[1.25rem]
                  focus:outline-none!
                  focus:shadow-[0_0_0_calc(0.0625rem+var(--inputs-border-width))_{{ block.settings.border_color }}]!
                  focus-visible:outline-none!
                  focus-visible:shadow-[0_0_0_calc(0.0625rem+var(--inputs-border-width))_{{ block.settings.border_color }}]!
                  peer
                "
                value="{{ form.email }}"
                aria-required="true"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                {% if form.errors %}
                  autofocus
                  aria-invalid="true"
                  aria-describedby="Newsletter-error--{{ section.id }}"
                {% elsif form.posted_successfully? %}
                  aria-describedby="Newsletter-success--{{ section.id }}"
                {% endif %}
                placeholder="{{ 'newsletter.label' | t }}"
                required
              >
              <label
                class="
                  absolute
                  left-[calc(var(--inputs-border-width)+1.25rem)]
                  top-[calc(0.625rem+var(--inputs-border-width))]
                  mb-0
                  pointer-events-none
                  text-[1rem]
                  leading-[1.5]
                  text-[{{ block.settings.color }}BF]
                  tracking-[0.0625rem]
                  transition-[top,font-size]
                  duration-[var(--duration-short)]
                  ease-[cubic-bezier(0.25,0.1,0.25,1)]
                  peer-focus:text-[0.625rem]
                  peer-autofill:text-[0.625rem]
                  peer-[&:not(:placeholder-shown)]:text-[0.625rem]
                  peer-focus:top-[calc(var(--inputs-border-width)+0.3125rem)]
                  peer-autofill:top-[calc(var(--inputs-border-width)+0.3125rem)]
                  peer-[&:not(:placeholder-shown)]:top-[calc(var(--inputs-border-width)+0.3125rem)]
                  peer-focus:tracking-[0.025rem]
                  peer-autofill:tracking-[0.025rem]
                  peer-[&:not(:placeholder-shown)]:tracking-[0.025rem]
                  peer-autofill:text-black
                "
                for="NewsletterForm--{{ section.id }}"
              >
                {{ block.settings.placeholder }}
              </label>
              <button
                type="submit"
                class="
                  w-[2.75rem]
                  m-0
                  right-[var(--inputs-border-width)]
                  top-0
                  h-full
                  z-[2]
                  focus-visible:bg-[{{ block.settings.color_background }}]
                  focus:shadow-[0_0_0_0.1875rem_rgb(var(--color-background)),0_0_0_0.25rem_rgba(var(--color-foreground))]
                  focus-visible:shadow-[0_0_0_0.1875rem_rgb(var(--color-background)),0_0_0_0.25rem_rgba(var(--color-foreground))]!
                  flex
                  items-center
                  justify-center
                  absolute
                  p-0
                  border-0
                  text-[{{ block.settings.color }}BF]
                  cursor-pointer
                  overflow-hidden
                  peer-autofill:text-black
                "
                name="commit"
                id="Subscribe"
                aria-label="{{ 'newsletter.button_label' | t }}"
              >
                <span
                  class="
                    inline-flex
                    justify-center
                    items-center
                    w-[25px]
                    h-[25px]
                    [&>svg]:h-full
                    [&>svg]:w-[15px]
                  "
                >
                  {{- 'icon-arrow.svg' | inline_asset_content -}}
                </span>
              </button>
            </div>
            {%- if form.errors -%}
              <small
                class="
                  mt-[15px]
                  justify-center
                  mb-0
                  md:justify-start
                  flex
                  items-center
                  text-sm
                  leading-none
                "
                id="Newsletter-error--{{ section.id }}"
              >
                <span
                  class="
                    inline-flex
                    justify-center
                    items-center
                    w-[20px]
                    h-[20px]
                    [&>svg]:flex-shrink-0
                    [&>svg]:h-[13px]
                    [&>svg]:w-[13px]
                    [&>svg]:mr-[5px]
                  "
                >
                  {{- 'icon-error.svg' | inline_asset_content -}}
                </span>
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </small>
            {%- endif -%}
          </div>
          {%- if form.posted_successfully? -%}
            <h3
              class="
                justify-center
                mb-0
                md:justify-start
                mt-[20px]
                flex
                items-center
                text-sm
                leading-none
              "
              id="Newsletter-success--{{ section.id }}"
              tabindex="-1"
              autofocus
            >
              <span
                class="
                  inline-flex
                  justify-center
                  items-center
                  w-[20px]
                  h-[20px]
                  [&>svg]:flex-shrink-0
                  [&>svg]:h-[13px]
                  [&>svg]:w-[13px]
                  [&>svg]:mr-[5px]
                "
              >
                {{- 'icon-success.svg' | inline_asset_content -}}
              </span>
              {{- 'newsletter.success' | t }}
            </h3>
          {%- endif -%}
        {% endform %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.email-signup-banner.name",
  "tag": null,
  "class": "div",
  "settings": [
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder",
      "default": "Email"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background color"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "300", "label": "300" },
        { "value": "275", "label": "275" },
        { "value": "250", "label": "250" },
        { "value": "225", "label": "225" },
        { "value": "200", "label": "200" },
        { "value": "175", "label": "175" },
        { "value": "150", "label": "150" },
        { "value": "125", "label": "125" },
        { "value": "100", "label": "100" },
        { "value": "auto", "label": "Auto" }
      ],
      "default": "auto"
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "Style",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "solid", "label": "Solid" },
        { "value": "dashed", "label": "Dashed" },
        { "value": "dotted", "label": "Dotted" },
        { "value": "double", "label": "Double" }
      ],
      "default": "solid"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 1,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Width",
      "default": 1
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Right",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Left",
      "default": 0
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "flex_basis_style",
      "label": "Flex basis",
      "default": false
    },
    {
      "type": "range",
      "id": "flex_basis",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Flex basis",
      "default": 0,
      "visible_if": "{{ block.settings.flex_basis_style }}"
    }
  ],
  "presets": [
    {
      "name": "t:sections.email-signup-banner.presets.name",
      "category": "t:categories.forms"
    }
  ]
}
{% endschema %}
